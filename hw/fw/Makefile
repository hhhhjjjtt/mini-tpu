# mini-tpu controller firmware (PicoRV32, RV32I).
#   make            -> build/fw.elf, build/fw.hex (4096 x 32-bit words, I-mem image),
#                      build/fw_image.h (same image as a C array, compiled into libfnp2)
#   make size

CROSS   ?= riscv-none-elf-
CC      := $(CROSS)gcc
OBJCOPY := $(CROSS)objcopy
OBJDUMP := $(CROSS)objdump
SIZE    := $(CROSS)size

BUILD   ?= build
CFLAGS  := -march=rv32i -mabi=ilp32 -O2 -ffreestanding -fno-builtin -nostdlib \
           -Wall -Wextra -Werror -msmall-data-limit=0 -I../interface $(EXTRA_CFLAGS)
LDFLAGS := -T link.ld -Wl,--gc-sections -lgcc

# msys make may not forward the Windows TMP to native tools (see ../rtl/Makefile)
ifneq ($(shell command -v cygpath 2>/dev/null),)
$(shell mkdir -p $(BUILD))
export TMP  := $(shell cygpath -w "$(abspath $(BUILD))")
export TEMP := $(TMP)
endif

SRCS    := start.S main.c
DEPS    := $(SRCS) mini_tpu_hw.h link.ld $(wildcard ../interface/*.h)

.PHONY: all size clean
all: $(BUILD)/fw.hex $(BUILD)/fw_image.h

$(BUILD)/fw.elf: $(DEPS)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ $(SRCS) $(LDFLAGS)
	$(OBJDUMP) -d $@ > $(BUILD)/fw.lst

# I-mem image: pad to 16 KB, one little-endian 32-bit word per line
$(BUILD)/fw.hex: $(BUILD)/fw.elf
	$(OBJCOPY) -O binary -j .text -j .rodata --pad-to=0x4000 --gap-fill=0 $< $(BUILD)/fw.bin
	od -An -v -tx4 -w4 $(BUILD)/fw.bin | tr -d ' ' > $@

# the used part of the image (trailing zero words dropped) for the ARM runtime
$(BUILD)/fw_image.h: $(BUILD)/fw.hex
	awk '{ w[NR] = $$1; if ($$1 != "00000000") n = NR } END { \
	  print "// Generated by hw/fw/Makefile from fw.hex. Do not edit."; \
	  print "#define MINI_TPU_FW_IMAGE_WORDS " n; \
	  print "static const unsigned int mini_tpu_fw_image[MINI_TPU_FW_IMAGE_WORDS] = {"; \
	  for (i = 1; i <= n; i++) printf "    0x%s,\n", w[i]; print "};" }' $< > $@

size: $(BUILD)/fw.elf
	$(SIZE) $<

clean:
	rm -rf $(BUILD)
